{
  "manifest_version": 3,
  "name": "Assistente do Microsoft Forms",
  "version": "15.10.6",
  "description": "Assistente para Microsoft Forms com gabarito, cartão-resposta, impressão, diagnóstico e organização de conteúdos.",
  "minimum_chrome_version": "105",
  "permissions": [
    "clipboardWrite",
    "storage"
  ],
  "host_permissions": [
    "https://forms.cloud.microsoft/*",
    "https://forms.office.com/*",
    "https://hive.forms.usercontent.microsoft/*",
    "https://*.forms.usercontent.microsoft/*",
    "https://statics.forms.microsoft/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://forms.cloud.microsoft/Pages/DesignPageV2.aspx*",
        "https://forms.office.com/Pages/DesignPageV2.aspx*",
        "https://forms.cloud.microsoft/Pages/EditFormPage.aspx*",
        "https://forms.office.com/Pages/EditFormPage.aspx*"
      ],
      "js": [
        "storage.js",
        "vendor/xlsx.full.min.js",
        "vendor/jszip.min.js",
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "Abrir o Assistente de Forms manualmente",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "assets/omr-template.jpg",
        "assets/answer-card-print.css",
        "assets/organizer-cabecalho.jpg",
        "assets/organizer-logo.png"
      ],
      "matches": [
        "https://forms.cloud.microsoft/*",
        "https://forms.office.com/*"
      ]
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
